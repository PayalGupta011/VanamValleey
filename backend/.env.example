# Vanam Valley Backend Environment Configuration Template
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vanam_valley?retryWrites=true&w=majority
# Or direct replica set string if SRV queries are blocked by your local network
MONGO_URI=mongodb://username:password@shard-00.mongodb.net:27017,shard-01.mongodb.net:27017/vanam_valley?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# JWT Secret Key for Admin Authentication (Use a 32+ character random string in production)
JWT_SECRET=your_jwt_private_secret_key_here_min_32_chars

# Cloudinary Storage Credentials for Media Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Production CORS Allowed Origin
# CLIENT_URL=https://your-vanam-valley-domain.com

